{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardian-receipt-v1",
  "title": "Guardian Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "guardian_version",
    "policy_version",
    "policy_digest",
    "generated_utc",
    "mode",
    "network",
    "checks",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "guardian-receipt-v1"
    },
    "guardian_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_utc": {
      "type": "string"
    },
    "mode": {
      "const": "READ_ONLY"
    },
    "network": {
      "const": "DISABLED_BY_DESIGN"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "tree": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "object"
    },
    "result": {
      "enum": [
        "VERIFIED",
        "ACTION_REQUIRED",
        "INDETERMINATE"
      ]
    }
  },
  "additionalProperties": false
}
